+static bool
+epoxy_android_use_mesa(void)
+{
+    const char *value = getenv("TERMUX_ANDROID_ZINK");
+    return value && value[0] != '\0' && strcmp(value, "0") != 0;
+}
+
+#if defined(__LP64__)
+#define ANDROID_SYSTEM_EGL_LIB "/system/lib64/libEGL.so"
+#define ANDROID_SYSTEM_GLES1_LIB "/system/lib64/libGLESv1_CM.so"
+#define ANDROID_SYSTEM_GLES2_LIB "/system/lib64/libGLESv2.so"
+#else
+#define ANDROID_SYSTEM_EGL_LIB "/system/lib/libEGL.so"
+#define ANDROID_SYSTEM_GLES1_LIB "/system/lib/libGLESv1_CM.so"
+#define ANDROID_SYSTEM_GLES2_LIB "/system/lib/libGLESv2.so"
+#endif
+#define TERMUX_MESA_EGL_LIB "/data/data/com.termux/files/usr/lib/libEGL.so.1"
+#define TERMUX_MESA_OPENGL_LIB "/data/data/com.termux/files/usr/lib/libOpenGL.so.0"
+#define TERMUX_MESA_GLES1_LIB "/data/data/com.termux/files/usr/lib/libGLESv1_CM.so.1"
+#define TERMUX_MESA_GLES2_LIB "/data/data/com.termux/files/usr/lib/libGLESv2.so.2"
+#define GLX_LIB (epoxy_android_use_mesa() ? TERMUX_MESA_OPENGL_LIB : ANDROID_SYSTEM_GLES2_LIB)
