+__attribute__((constructor)) static void isolate_preload(void) {
+    // The launcher preloads this dispatcher only for Hyprland. Clients must use
+    // their own GL stack rather than inheriting this process's namespace loader.
+    unsetenv("LD_PRELOAD");
+}
+static void initialize_platform(void) {
+#ifdef __LP64__
+    const char* egl_path  = "/system/lib64/libEGL.so";
+    const char* gles_path = "/system/lib64/libGLESv2.so";
+#else
+    const char* egl_path  = "/system/lib/libEGL.so";
+    const char* gles_path = "/system/lib/libGLESv2.so";
+#endif
+    Dl_info self = {0};
+    char    loader[PATH_MAX];
+    if (!dladdr((const void*)&initialize_platform, &self) || !self.dli_fname || strlen(self.dli_fname) >= sizeof(loader)) {
+        fprintf(stderr, "Hyprland Android cannot locate its private driver loader\n");
+        abort();
+    }
+    strcpy(loader, self.dli_fname);
+    char* slash = strrchr(loader, '/');
+    if (!slash || snprintf(slash + 1, sizeof(loader) - (size_t)(slash + 1 - loader), "libvndksupport.so") >= (int)(sizeof(loader) - (size_t)(slash + 1 - loader))) {
+        fprintf(stderr, "Hyprland Android private driver loader path is invalid\n");
+        abort();
+    }
+    if (!platform_dlopen(loader, RTLD_NOW | RTLD_LOCAL)) {
+        fprintf(stderr, "Hyprland Android driver namespace unavailable: %s\n", dlerror());
+        abort();
+    }
+    platform_egl  = platform_dlopen(egl_path, RTLD_NOW | RTLD_LOCAL);
+    platform_gles = platform_dlopen(gles_path, RTLD_NOW | RTLD_LOCAL);
+    if (!platform_egl || !platform_gles) {
+        fprintf(stderr, "Hyprland Android EGL/GLES unavailable: %s\n", dlerror());
+        abort();
+    }
