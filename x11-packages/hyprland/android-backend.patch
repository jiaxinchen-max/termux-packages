@@ -52,5 +55,75 @@ CKeyboard::CKeyboard(SP<Aquamarine::IKeyboard> keeb) : IKeyboard(keeb ? keeb->ge
         });
     });
 
+#ifdef __ANDROID__
+    m_listeners.unicode = keeb->events.unicode.listen([this](uint32_t timeMs, uint32_t code) { commitUnicode(timeMs, code); });
+#endif
     m_deviceName = keeb->getName();
 }
+
+#ifdef __ANDROID__
+void CKeyboard::commitUnicode(uint32_t timeMs, uint32_t code) {
+    if (!m_enabled || !m_allowed || !m_xkbKeymap || !code || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF))
+        return;
+
+    // Reuse the configured keymap whenever possible. Replacing it for every ASCII
+    // character makes client toolkit key caches race under rapid IME commits.
+    const auto PREVIOUS = g_pSeatManager->m_keyboard.lock();
+    const auto GROUP    = m_modifiersState.group;
+    for (auto key = xkb_keymap_min_keycode(m_xkbKeymap); key <= std::min(xkb_keymap_max_keycode(m_xkbKeymap), 255U); ++key) {
+        const auto LEVELS = xkb_keymap_num_levels_for_key(m_xkbKeymap, key, GROUP);
+        for (xkb_level_index_t level = 0; level < LEVELS; ++level) {
+            const xkb_keysym_t* symbols = nullptr;
+            if (xkb_keymap_key_get_syms_by_level(m_xkbKeymap, key, GROUP, level, &symbols) != 1 || xkb_keysym_to_utf32(symbols[0]) != code)
+                continue;
+            xkb_mod_mask_t mask = 0;
+            if (level && xkb_keymap_key_get_mods_for_level(m_xkbKeymap, key, GROUP, level, &mask, 1) != 1)
+                continue;
+            g_pSeatManager->setKeyboard(m_self.lock());
+            g_pSeatManager->sendKeyboardMods(mask, 0, 0, GROUP);
+            g_pSeatManager->sendKeyboardKey(timeMs, key - 8, WL_KEYBOARD_KEY_STATE_PRESSED);
+            g_pSeatManager->sendKeyboardKey(timeMs, key - 8, WL_KEYBOARD_KEY_STATE_RELEASED);
+            g_pSeatManager->setKeyboard(PREVIOUS);
+            if (PREVIOUS) {
+                const auto& mods = PREVIOUS->m_modifiersState;
+                g_pSeatManager->sendKeyboardMods(mods.depressed, mods.latched, mods.locked, mods.group);
+            }
+            return;
+        }
+    }
+
+    // Android IMEs commit characters rather than physical keys. Publish a temporary
+    // one-level map so every Wayland client can consume Unicode without assuming a
+    // keyboard layout, synthesizing shortcuts, or changing the physical XKB state.
+    const auto CONTEXT = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+    if (!CONTEXT)
+        return;
+    const auto TEXT   = std::format("xkb_keymap {{ xkb_keycodes {{ minimum=8; maximum=255; <TEXT>=255; }}; "
+                                    "xkb_types {{ type \"ONE_LEVEL\" {{ modifiers=None; level_name[Level1]=\"Any\"; }}; }}; "
+                                    "xkb_compatibility {{}}; xkb_symbols {{ key <TEXT> {{ type=\"ONE_LEVEL\", [ U{:04X} ] }}; }}; }};",
+                                    code);
+    const auto KEYMAP = xkb_keymap_new_from_string(CONTEXT, TEXT.c_str(), XKB_KEYMAP_FORMAT_TEXT_V1, XKB_KEYMAP_COMPILE_NO_FLAGS);
+    xkb_context_unref(CONTEXT);
+    if (!KEYMAP)
+        return;
+
+    const auto ORIGINAL = m_xkbKeymap;
+    m_xkbKeymap         = KEYMAP;
+    updateKeymapFD();
+    g_pSeatManager->setKeyboard(m_self.lock());
+    g_pSeatManager->updateActiveKeyboardData();
+    g_pSeatManager->sendKeyboardMods(0, 0, 0, 0);
+    g_pSeatManager->sendKeyboardKey(timeMs, 247, WL_KEYBOARD_KEY_STATE_PRESSED);
+    g_pSeatManager->sendKeyboardKey(timeMs, 247, WL_KEYBOARD_KEY_STATE_RELEASED);
+
+    m_xkbKeymap = ORIGINAL;
+    updateKeymapFD();
+    g_pSeatManager->setKeyboard(PREVIOUS);
+    g_pSeatManager->updateActiveKeyboardData();
+    if (PREVIOUS) {
+        const auto& mods = PREVIOUS->m_modifiersState;
+        g_pSeatManager->sendKeyboardMods(mods.depressed, mods.latched, mods.locked, mods.group);
+    }
+    xkb_keymap_unref(KEYMAP);
+}
+#endif
