+static void* resolve_platform(const char* name, int gles) {
+    pthread_once(&platform_once, initialize_platform);
+    void* function = dlsym(gles ? platform_gles : platform_egl, name);
+    if (!function) {
+        fprintf(stderr, "Hyprland Android missing system symbol: %s\n", name);
+        abort();
+    }
+    return function;
