+bool CAndroidBackend::start() {
+    m_width       = positiveEnv("AQ_ANDROID_WIDTH", 1280, 16384);
+    m_height      = positiveEnv("AQ_ANDROID_HEIGHT", 720, 16384);
+    m_refresh     = positiveEnv("AQ_ANDROID_REFRESH", 60, 240);
+    m_inputWidth  = m_width;
+    m_inputHeight = m_height;
+    setKeycodeFormat(LORIE_KEYCODE_EVDEV);
+    setScreenConfig(m_width, m_height, m_refresh, AHARDWAREBUFFER_FORMAT_B8G8R8A8_UNORM, LORIEBUFFER_AHARDWAREBUFFER);
+    if (connectToRender() != 0)
+        return false;
+    m_connected             = true;
+    m_allocator             = makeShared<CAndroidAllocator>(m_backend.lock());
+    m_timer                 = Hyprutils::OS::CFileDescriptor{timerfd_create(CLOCK_MONOTONIC, TFD_NONBLOCK | TFD_CLOEXEC)};
+    const auto       period = 1000000000LL / m_refresh;
+    const itimerspec timer  = {.it_interval = {.tv_sec = 0, .tv_nsec = period}, .it_value = {.tv_sec = 0, .tv_nsec = period}};
+    return m_timer.isValid() && timerfd_settime(m_timer.get(), 0, &timer, nullptr) == 0;
+}
+void CAndroidBackend::onReady() {
+    if (m_keyboard)
+        return;
+
+    m_keyboard = makeShared<CAndroidKeyboard>();
+    m_pointer  = makeShared<CAndroidPointer>();
+    m_touch    = makeShared<CAndroidTouch>();
+    // onReady runs inside CBackend::start, before the consumer's input and seat
+    // managers exist. Publish devices only once its event loop starts polling.
+    m_backend->addIdleEvent(makeShared<std::function<void(void)>>([weak = m_self] {
+        const auto self = weak.lock();
+        if (!self)
+            return;
+
+        self->m_backend->events.newKeyboard.emit(self->m_keyboard);
+        self->m_backend->events.newPointer.emit(self->m_pointer);
+        self->m_backend->events.newTouch.emit(self->m_touch);
+        self->m_inputReady = true;
+    }));
+    if (!createOutput())
+        throw std::runtime_error("Unable to create Android output");
+}
+bool CAndroidBackend::createOutput(const std::string& name) {
+    if (m_output)
+        return false;
+    auto output         = makeShared<CAndroidOutput>(m_self.lock());
+    output->name        = name.empty() ? "ANDROID-1" : name;
+    output->description = "Termux Android display";
+    output->make        = "Termux";
+    output->model       = "Android";
+    output->modes.emplace_back(makeShared<SOutputMode>(Vector2D{m_width, m_height}, m_refresh * 1000, true));
+    output->swapchain = CSwapchain::create(m_allocator, m_self.lock());
+    m_output          = output;
+    m_backend->events.newOutput.emit(m_output);
+    return true;
+}
+std::vector<CSharedPointer<SPollFD>> CAndroidBackend::pollFDs() {
+    if (!m_connected)
+        return {};
+    return {makeShared<SPollFD>(get_conn_fd(), [this] { dispatchEvents(); }), makeShared<SPollFD>(m_timer.get(), [this] {
+                uint64_t ticks = 0;
+                if (read(m_timer.get(), &ticks, sizeof(ticks)) == sizeof(ticks) && m_output && m_output->needsFrame)
+                    m_output->events.frame.emit();
+                if (!waylandConnectionAlive())
+                    throw std::runtime_error("Android display connection closed");
+            })};
+}
+bool CAndroidBackend::dispatchEvents() {
+    // Leave queued input on the socket until all devices have been published.
+    if (!m_inputReady)
+        return true;
+
+    std::array<uint8_t, 4096> bytes{};
+    ssize_t                   count = 0;
+    // Bound each dispatch so a continuous input stream cannot starve frame dispatch.
+    size_t received = 0;
+    while (received < 65536 && (count = recv(get_conn_fd(), bytes.data(), bytes.size(), MSG_DONTWAIT)) > 0) {
+        m_input.insert(m_input.end(), bytes.begin(), bytes.begin() + count);
+        received += count;
+    }
+    if (count == 0 || (count < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR))
+        throw std::runtime_error("Android input connection closed");
+    const auto now    = std::chrono::steady_clock::now().time_since_epoch();
+    const auto timeMs = static_cast<uint32_t>(std::chrono::duration_cast<std::chrono::milliseconds>(now).count());
+    size_t     offset = 0;
+    while (offset < m_input.size()) {
+        if (m_discard) {
+            const auto skip = std::min(m_discard, m_input.size() - offset);
+            offset += skip;
+            m_discard -= skip;
+            continue;
+        }
+        if (m_input.size() - offset < sizeof(lorieEvent))
+            break;
+        lorieEvent event{};
+        std::memcpy(&event, m_input.data() + offset, sizeof(event));
+        offset += sizeof(event);
+        if (event.type == EVENT_CLIPBOARD_SEND) {
+            if (event.clipboardSend.count > 16 * 1024 * 1024)
+                throw std::runtime_error("Android clipboard payload exceeds limit");
+            m_discard = event.clipboardSend.count;
+        } else if (event.type == EVENT_SCREEN_SIZE) {
+            if (event.screenSize.name_size > 4096)
+                throw std::runtime_error("Android screen name exceeds limit");
+            m_discard = event.screenSize.name_size;
+            if (event.screenSize.width && event.screenSize.height) {
+                m_inputWidth  = event.screenSize.width;
+                m_inputHeight = event.screenSize.height;
+            }
+        } else if (event.type == EVENT_KEY)
+            m_keyboard->events.key.emit(IKeyboard::SKeyEvent{.timeMs = timeMs, .key = event.key.key, .pressed = event.key.state != 0});
+        else if (event.type == EVENT_UNICODE) {
+            const auto code = event.unicode.code;
+            if (code && code <= 0x10FFFF && (code < 0xD800 || code > 0xDFFF))
+                m_keyboard->events.unicode.emit(timeMs, code);
+        } else if (event.type == EVENT_MOUSE) {
+            if (!event.mouse.detail) {
+                if (event.mouse.relative) {
+                    const Vector2D delta{event.mouse.x * m_width / m_inputWidth, event.mouse.y * m_height / m_inputHeight};
+                    m_pointer->events.move.emit(IPointer::SMoveEvent{.timeMs = timeMs, .delta = delta, .unaccel = delta});
+                } else
+                    m_pointer->events.warp.emit(
+                        IPointer::SWarpEvent{.timeMs = timeMs, .absolute = {event.mouse.x / m_inputWidth, event.mouse.y / m_inputHeight}, .output = m_output});
+            } else if (event.mouse.detail <= 3) {
+                const std::array<uint32_t, 3> buttons = {BTN_LEFT, BTN_MIDDLE, BTN_RIGHT};
+                m_pointer->events.button.emit(IPointer::SButtonEvent{.timeMs = timeMs, .button = buttons.at(event.mouse.detail - 1), .pressed = event.mouse.down != 0});
+            } else if (event.mouse.detail <= 5) {
+                const bool horizontal = event.mouse.detail == 4;
+                m_pointer->events.axis.emit(IPointer::SAxisEvent{.timeMs = timeMs,
+                                                                 .axis   = horizontal ? IPointer::AQ_POINTER_AXIS_HORIZONTAL : IPointer::AQ_POINTER_AXIS_VERTICAL,
+                                                                 .source = IPointer::AQ_POINTER_AXIS_SOURCE_WHEEL,
+                                                                 .delta  = horizontal ? event.mouse.x : event.mouse.y});
+            }
+            m_pointer->events.frame.emit();
+        } else if (event.type == EVENT_TOUCH) {
+            const Vector2D pos{static_cast<double>(event.touch.x) / m_inputWidth, static_cast<double>(event.touch.y) / m_inputHeight};
+            if (event.touch.type == 18)
+                m_touch->events.down.emit(ITouch::SDownEvent{.timeMs = timeMs, .touchID = event.touch.id, .pos = pos});
+            else if (event.touch.type == 19)
+                m_touch->events.up.emit(ITouch::SUpEvent{.timeMs = timeMs, .touchID = event.touch.id});
+            else if (event.touch.type == 20)
+                m_touch->events.move.emit(ITouch::SMotionEvent{.timeMs = timeMs, .touchID = event.touch.id, .pos = pos});
+            m_touch->events.frame.emit();
+        }
+    }
+    m_input.erase(m_input.begin(), m_input.begin() + offset);
+    return true;
+}
