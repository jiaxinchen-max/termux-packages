@@ -0,0 +1,74 @@
+#pragma once
+
+#include "Backend.hpp"
+#include "../buffer/Buffer.hpp"
+#include "../output/Output.hpp"
+#include "../input/Input.hpp"
+#include <hyprutils/os/FileDescriptor.hpp>
+
+struct AHardwareBuffer;
+struct LorieBuffer;
+
+namespace Aquamarine {
+    // Native Android buffers are deliberately not advertised as Linux dmabufs.
+    class CAndroidBuffer : public IBuffer {
+      public:
+        CAndroidBuffer(const SAllocatorBufferParams& params);
+        ~CAndroidBuffer() override;
+        eBufferCapability caps() override;
+        eBufferType       type() override;
+        void              update(const Hyprutils::Math::CRegion& damage) override;
+        bool              isSynchronous() override;
+        bool              good() override;
+        SDMABUFAttrs      dmabuf() override;
+        AHardwareBuffer*  hardwareBuffer() const;
+        void              beginRender();
+        void              endRender();
+        bool              hasRendered() const;
+        bool              present();
+
+      private:
+        LorieBuffer* m_buffer       = nullptr;
+        bool         m_registered   = false;
+        bool         m_renderLocked = false;
+        bool         m_hasRendered  = false;
+        void         unlockRender();
+    };
+
+    class CAndroidBackend : public IBackendImplementation {
+      public:
+        static Hyprutils::Memory::CSharedPointer<CAndroidBackend> create(Hyprutils::Memory::CSharedPointer<CBackend> backend);
+        ~CAndroidBackend() override;
+        eBackendType                                               type() override;
+        bool                                                       start() override;
+        std::vector<Hyprutils::Memory::CSharedPointer<SPollFD>>    pollFDs() override;
+        int                                                        drmFD() override;
+        int                                                        drmRenderNodeFD() override;
+        bool                                                       dispatchEvents() override;
+        uint32_t                                                   capabilities() override;
+        void                                                       onReady() override;
+        std::vector<SDRMFormat>                                    getRenderFormats() override;
+        std::vector<SDRMFormat>                                    getCursorFormats() override;
+        bool                                                       createOutput(const std::string& name = "") override;
+        Hyprutils::Memory::CSharedPointer<IAllocator>              preferredAllocator() override;
+        std::vector<Hyprutils::Memory::CSharedPointer<IAllocator>> getAllocators() override;
+        Hyprutils::Memory::CWeakPointer<IBackendImplementation>    getPrimary() override;
+
+      private:
+        CAndroidBackend(Hyprutils::Memory::CSharedPointer<CBackend> backend);
+        Hyprutils::Memory::CWeakPointer<CBackend>        m_backend;
+        Hyprutils::Memory::CWeakPointer<CAndroidBackend> m_self;
+        Hyprutils::Memory::CSharedPointer<IOutput>       m_output;
+        Hyprutils::Memory::CSharedPointer<IKeyboard>     m_keyboard;
+        Hyprutils::Memory::CSharedPointer<IPointer>      m_pointer;
+        Hyprutils::Memory::CSharedPointer<ITouch>        m_touch;
+        Hyprutils::Memory::CSharedPointer<IAllocator>    m_allocator;
+        Hyprutils::OS::CFileDescriptor                   m_timer;
+        std::vector<uint8_t>                             m_input;
+        size_t                                           m_discard = 0;
+        int                                              m_width = 1280, m_height = 720, m_refresh = 60;
+        int                                              m_inputWidth = 1280, m_inputHeight = 720;
+        bool                                             m_connected  = false;
+        bool                                             m_inputReady = false;
+    };
+}
diff --git a/src/backend/Android.cpp b/src/backend/Android.cpp
new file mode 100644
index 0000000..5e0362a
--- /dev/null
+++ b/src/backend/Android.cpp
@@ -0,0 +1,410 @@
+#include <aquamarine/backend/Android.hpp>
+#include <aquamarine/allocator/Swapchain.hpp>
+#include <hyprutils/memory/SharedPtr.hpp>
+#include <GLES3/gl3.h>
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <csignal>
+#include <cstring>
+#include <cstdlib>
+#include <stdexcept>
+#include <sys/timerfd.h>
+#include <unistd.h>
+
+extern "C" {
+#include <termux/render/render.h>
+}
+
+using namespace Aquamarine;
+using namespace Hyprutils::Memory;
+using namespace Hyprutils::Math;
+
+static int positiveEnv(const char* name, int fallback, int maximum) {
+    const auto* text = std::getenv(name);
+    if (!text)
+        return fallback;
+    char*      end   = nullptr;
+    const auto value = std::strtol(text, &end, 10);
+    if (end == text || *end || value <= 0 || value > maximum)
+        throw std::runtime_error(std::string("Invalid Android output option: ") + name);
+    return value;
+}
+
+CAndroidBuffer::CAndroidBuffer(const SAllocatorBufferParams& params) {
+    if (params.size.x <= 0 || params.size.y <= 0 || params.size.x > 16384 || params.size.y > 16384 || (params.format != DRM_FORMAT_INVALID && params.format != DRM_FORMAT_ARGB8888))
+        return;
+    size     = params.size;
+    opaque   = false;
+    m_buffer = LorieBuffer_allocate(size.x, size.y, AHARDWAREBUFFER_FORMAT_B8G8R8A8_UNORM, LORIEBUFFER_AHARDWAREBUFFER);
+    if (!m_buffer)
+        return;
+    const auto* desc = LorieBuffer_description(m_buffer);
+    if (!desc->buffer || desc->format != AHARDWAREBUFFER_FORMAT_B8G8R8A8_UNORM)
+        return;
+    m_registered = registerBufferToRender(m_buffer) == 0;
+}
+
+CAndroidBuffer::~CAndroidBuffer() {
+    unlockRender();
+    if (m_registered)
+        unregisterBufferFromRender(m_buffer);
+    LorieBuffer_release(m_buffer);
+}
+
+eBufferCapability CAndroidBuffer::caps() {
+    return BUFFER_CAPABILITY_NONE;
+}
+eBufferType CAndroidBuffer::type() {
+    return BUFFER_TYPE_MISC;
+}
+void CAndroidBuffer::update(const CRegion&) {
+    ;
+}
+bool CAndroidBuffer::isSynchronous() {
+    return false;
+}
+bool CAndroidBuffer::good() {
+    return m_registered;
+}
+SDMABUFAttrs CAndroidBuffer::dmabuf() {
+    // Format metadata is used by swapchain selection; success stays false and no FD is exported.
+    return {.success = false, .size = size, .format = DRM_FORMAT_ARGB8888};
+}
+AHardwareBuffer* CAndroidBuffer::hardwareBuffer() const {
+    return m_buffer ? LorieBuffer_description(m_buffer)->buffer : nullptr;
+}
+void CAndroidBuffer::beginRender() {
+    if (m_renderLocked)
+        return;
+    auto* state = get_serverState();
+    if (!state || !waylandConnectionAlive())
+        throw std::runtime_error("Android render connection lost");
+    lorie_mutex_lock(&state->lock, &state->lockingPid);
+    m_renderLocked = true;
+}
+void CAndroidBuffer::endRender() {
+    if (!m_renderLocked)
+        return;
+    glFinish();
+    m_hasRendered = true;
+    unlockRender();
+}
+bool CAndroidBuffer::hasRendered() const {
+    return m_hasRendered;
+}
+void CAndroidBuffer::unlockRender() {
+    if (!m_renderLocked)
+        return;
+    if (auto* state = get_serverState())
+        lorie_mutex_unlock(&state->lock, &state->lockingPid);
+    m_renderLocked = false;
+}
+bool CAndroidBuffer::present() {
+    endRender();
+    if (!good() || !waylandConnectionAlive())
+        return false;
+    // Modeset validation may commit a freshly allocated buffer before any draw.
+    if (!m_hasRendered)
+        return true;
+    beginRender();
+    // This backend does not claim DRM timeline support. Finish GPU writes before
+    // releasing the same shared lock used by the Android texture consumer.
+    glFinish();
+    auto* state                = get_serverState();
+    state->rootWindowTextureID = LorieBuffer_description(m_buffer)->id;
+    state->drawRequested       = true;
+    state->waitForNextFrame    = false;
+    if (rendererCond)
+        pthread_cond_signal(rendererCond);
+    unlockRender();
+    return true;
+}
+
+class CAndroidAllocator : public IAllocator {
+  public:
+    explicit CAndroidAllocator(CSharedPointer<CBackend> backend) : m_backend(backend) {
+        ;
+    }
+    CSharedPointer<IBuffer> acquire(const SAllocatorBufferParams& params, CSharedPointer<CSwapchain>) override {
+        auto buffer = makeShared<CAndroidBuffer>(params);
+        return buffer->good() ? buffer : nullptr;
+    }
+    CSharedPointer<CBackend> getBackend() override {
+        return m_backend.lock();
+    }
+    int drmFD() override {
+        return -1;
+    }
+    eAllocatorType type() override {
+        return AQ_ALLOCATOR_TYPE_ANDROID;
+    }
+
+  private:
+    CWeakPointer<CBackend> m_backend;
+};
+
+class CAndroidKeyboard : public IKeyboard {
+  public:
+    const std::string& getName() override {
+        return m_name;
+    }
+
+  private:
+    const std::string m_name = "Termux Android keyboard";
+};
+class CAndroidPointer : public IPointer {
+  public:
+    const std::string& getName() override {
+        return m_name;
+    }
+
+  private:
+    const std::string m_name = "Termux Android pointer";
+};
+class CAndroidTouch : public ITouch {
+  public:
+    const std::string& getName() override {
+        return m_name;
+    }
+
+  private:
+    const std::string m_name = "Termux Android touch";
+};
+
+class CAndroidOutput : public IOutput {
+  public:
+    explicit CAndroidOutput(CSharedPointer<CAndroidBackend> backend) : m_backend(backend) {
+        ;
+    }
+    bool test() override {
+        const auto& pending = state->state();
+        return !pending.adaptiveSync && pending.presentationMode == AQ_OUTPUT_PRESENTATION_VSYNC && pending.explicitInFence < 0 && pending.explicitOutFence < 0 &&
+            (pending.drmFormat == DRM_FORMAT_INVALID || pending.drmFormat == DRM_FORMAT_ARGB8888);
+    }
+    bool commit() override {
+        if (!test())
+            return false;
+        const auto  snapshot = state->snapshot();
+        const auto& pending  = snapshot.state();
+        if (snapshot.error())
+            return false;
+        auto buffer = dynamic_cast<CAndroidBuffer*>(pending.buffer.get());
+        if (pending.buffer && (!buffer || !buffer->present()))
+            return false;
+        enabled    = pending.enabled;
+        needsFrame = false;
+        events.commit.emit();
+        state->consume(snapshot);
+        if (buffer && buffer->hasRendered()) {
+            // Render completion only: the protocol supplies no Android presentation timestamp.
+            events.present.emit(SPresentEvent{.presented = true, .flags = 0});
+        }
+        return true;
+    }
+    CSharedPointer<IBackendImplementation> getBackend() override {
+        return m_backend.lock();
+    }
+    std::vector<SDRMFormat> getRenderFormats() override {
+        return m_backend->getRenderFormats();
+    }
+    bool pendingPageFlip() override {
+        return false;
+    }
+    bool pendingIdleFrame() override {
+        return needsFrame;
+    }
+    void scheduleFrame(const scheduleFrameReason) override {
+        needsFrame = true;
+    }
+
+  private:
+    CWeakPointer<CAndroidBackend> m_backend;
+};
+
+CAndroidBackend::CAndroidBackend(CSharedPointer<CBackend> backend) : m_backend(backend) {
+    ;
+}
+CSharedPointer<CAndroidBackend> CAndroidBackend::create(CSharedPointer<CBackend> backend) {
+    auto result    = CSharedPointer<CAndroidBackend>(new CAndroidBackend(backend));
+    result->m_self = result;
+    return result;
+}
+CAndroidBackend::~CAndroidBackend() {
+    m_output.reset();
+    m_allocator.reset();
+    if (m_connected)
+        stopEventLoop();
